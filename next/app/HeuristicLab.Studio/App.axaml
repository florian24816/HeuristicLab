<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HeuristicLab.Studio.App"
             xmlns:local="using:HeuristicLab.Studio"
             xmlns:vm="using:HeuristicLab.Studio.ViewModels"
             RequestedThemeVariant="Light">
             <!-- light or dark: the button at the top left of the main window (MainViewModel.IsDarkMode) -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <!-- every window (dialogs too) shows HeuristicLab's icon -->
        <Style Selector=":is(Window)">
            <Setter Property="Icon" Value="/Assets/HeuristicLab.ico" />
            <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
        </Style>
        <FluentTheme />
        <!-- a field edited across algorithms (Shift+click): purple -->
        <Style Selector="TextBox.multi /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#E8D5F2" />
            <Setter Property="BorderBrush" Value="#8E44AD" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="TextBox.multi">
            <Setter Property="Foreground" Value="#1E1E1E" />
        </Style>
        <Style Selector="ComboBox.multi /template/ Border#Background">
            <Setter Property="Background" Value="#E8D5F2" />
            <Setter Property="BorderBrush" Value="#8E44AD" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="CheckBox.multi">
            <Setter Property="Background" Value="#E8D5F2" />
            <Setter Property="BorderBrush" Value="#8E44AD" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="8,0,8,0" />
        </Style>
        <!-- categorized lists (algorithms, problems): each row tinted with its category's color,
             the first row of a category headed by the category's name -->
        <Style Selector="ListBox.catalog > ListBoxItem" x:DataType="vm:CatalogItem">
            <Setter Property="Background" Value="{Binding Tint}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,0,1" />
        </Style>
    </Application.Styles>

    <Application.Resources>
      <ResourceDictionary>
        <!-- colors that differ between light and dark mode -->
        <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Light">
                <SolidColorBrush x:Key="WindowBrush" Color="White" />
                <SolidColorBrush x:Key="WarningBrush" Color="#B0563A" />
                <SolidColorBrush x:Key="ErrorBrush" Color="#C23B4A" />
                <!-- an experiment's area in the Experiments tab, its writing, a hovered arrow/link -->
                <SolidColorBrush x:Key="ExperimentBrush" Color="#D5CFC6" />
                <SolidColorBrush x:Key="ExperimentInkBrush" Color="#1E1E1E" />
                <SolidColorBrush x:Key="ExperimentHoverBrush" Color="#C4BCB0" />
                <!-- the notifications button when off -->
                <SolidColorBrush x:Key="SwitchOffBrush" Color="#E0E0E0" />
                <SolidColorBrush x:Key="SwitchOffHoverBrush" Color="#CDCDCD" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="Dark">
                <SolidColorBrush x:Key="WindowBrush" Color="#1E1E1E" />
                <SolidColorBrush x:Key="WarningBrush" Color="#F2A27E" />
                <SolidColorBrush x:Key="ErrorBrush" Color="#F08A95" />
                <SolidColorBrush x:Key="ExperimentBrush" Color="#36322E" />
                <SolidColorBrush x:Key="ExperimentInkBrush" Color="#EDEDED" />
                <SolidColorBrush x:Key="ExperimentHoverBrush" Color="#4A453F" />
                <SolidColorBrush x:Key="SwitchOffBrush" Color="#6B6B6B" />
                <SolidColorBrush x:Key="SwitchOffHoverBrush" Color="#7A7A7A" />
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <DataTemplate x:Key="CatalogItemTemplate" x:DataType="vm:CatalogItem">
            <StackPanel Spacing="1">
                <TextBlock Text="{Binding Category}" IsVisible="{Binding StartsGroup}" Foreground="{Binding Accent}"
                           FontWeight="Bold" FontSize="12" Margin="0,6,0,4" />
                <TextBlock Text="{Binding Display}" FontWeight="SemiBold" Foreground="#1E1E1E" />
                <TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}" Foreground="#1E1E1E" Opacity="0.7"
                           FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
      </ResourceDictionary>
    </Application.Resources>
</Application>