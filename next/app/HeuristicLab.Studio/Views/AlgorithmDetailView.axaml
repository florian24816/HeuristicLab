<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HeuristicLab.Studio.ViewModels"
             xmlns:c="using:HeuristicLab.Studio.Controls"
             xmlns:controls="using:HeuristicLab.Studio.Controls"
             xmlns:runtime="using:HeuristicLab.Next.Runtime"
             x:Class="HeuristicLab.Studio.Views.AlgorithmDetailView"
             x:DataType="vm:AlgorithmDetailViewModel">
    <UserControl.Styles>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,2" />
        </Style>

        <!-- the quick batch run's controls (user's request 2026-11-10): square fields and buttons of one height in the
             logo orange's shades with dark writing, in both modes (as the blocks); "Quick batch" / "run" #FBCD96 bold,
             "of <size>" one box in the grey of what cannot be pressed (ExecOffBrush, bold); Start full orange, Pause / Stop a shade paler, Prepare palest; a
             button that cannot be pressed now is grey (ExecOffBrush: lighter than the window in dark mode) -->
        <Style Selector="Border.qbr">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="#FBCD96" />
        </Style>
        <Style Selector="Border.qbr > TextBlock">
            <Setter Property="Foreground" Value="#1E1E1E" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.qbr.size">
            <Setter Property="Background" Value="{DynamicResource ExecOffBrush}" />
            <Setter Property="MinWidth" Value="60" />
        </Style>
        <Style Selector="Border.qbr.size > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ExecOffInkBrush}" />
        </Style>
        <Style Selector="Button.exec">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#1E1E1E" />
            <Setter Property="Background" Value="#F9B462" />
        </Style>
        <Style Selector="Button.exec /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.exec:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F7A443" />
            <Setter Property="Foreground" Value="#1E1E1E" />
        </Style>
        <Style Selector="Button.exec:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E8850F" />
        </Style>
        <Style Selector="Button.exec.start">
            <Setter Property="Background" Value="#F7931D" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.exec.start:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E8850F" />
        </Style>
        <Style Selector="Button.exec.prepare">
            <Setter Property="Background" Value="#FDE5C8" />
        </Style>
        <Style Selector="Button.exec.prepare:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FBCD96" />
        </Style>
        <Style Selector="Button.exec:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ExecOffBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ExecOffInkBrush}" />
        </Style>
    </UserControl.Styles>
    <DockPanel>
        <!-- name -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,0,0,8">
            <TextBlock Text="Name" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding Name}" IsReadOnly="{Binding !CanEdit}" />
            <TextBlock Grid.Column="2" Text="{Binding Kind}" VerticalAlignment="Center" Opacity="0.65" />
        </Grid>

        <!-- execution controls -->
        <Border DockPanel.Dock="Bottom" Padding="0,8,0,0" BorderThickness="0,1,0,0" Margin="0,8,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <!-- "Quick batch | of | 10 | run": the size set in the Options tab (the one in use while a QBR runs) -->
                <StackPanel x:Name="QbrTitle" Orientation="Horizontal" Spacing="2"
                            ToolTip.Tip="Start makes a quick batch run (QBR): the algorithm runs this many times; the runs go to &quot;Quick batch runs&quot; in the Runs and Results tabs. The size is set in the Options tab.">
                    <Border Classes="qbr"><TextBlock Text="Quick batch" /></Border>
                    <Border Classes="qbr size"><TextBlock Text="{Binding BatchSizeText, StringFormat='of {0}'}" /></Border>
                    <Border Classes="qbr"><TextBlock Text="run" /></Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Classes="exec start" Content="&#x25B6; Start" Command="{Binding StartCommand}"
                            ToolTip.Tip="Start the quick batch run; after a pause: resume it" />
                    <Button Classes="exec" Content="&#x23F8; Pause" Command="{Binding PauseCommand}" />
                    <Button Classes="exec" Content="&#x23F9; Stop" Command="{Binding StopCommand}" ToolTip.Tip="Stop: the runs made so far are the quick batch run" />
                    <Button Classes="exec prepare" Content="&#x21BA; Prepare" Command="{Binding PrepareCommand}" ToolTip.Tip="Reset results (runs are kept)" />
                </StackPanel>
                <TextBlock Text="{Binding State}" VerticalAlignment="Center" Margin="4,0,0,0" />
                <TextBlock Text="{Binding ExecutionTime}" VerticalAlignment="Center" FontFamily="monospace" />
                <TextBlock Text="{Binding BatchProgress}" IsVisible="{Binding BatchProgress, Converter={x:Static ObjectConverters.IsNotNull}}"
                           VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Opacity="0.75" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding Message}" />
            </StackPanel>
        </Border>

        <TabControl SelectedIndex="{Binding SelectedTab}" Padding="0,8,0,0">
            <TabItem Header="Problem">
                <Panel>
                    <StackPanel Spacing="10" IsVisible="{Binding !HasProblem}">
                        <TextBlock Text="This algorithm has no problem yet." Opacity="0.7" />
                        <Button Content="+ Add problem" Command="{Binding ChooseProblemCommand}" Background="#F2C94C" Foreground="#1E2A1F" />
                    </StackPanel>
                    <DockPanel IsVisible="{Binding HasProblem}">
                        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{Binding ProblemSource}" VerticalAlignment="Center" />
                                <Button Content="Change problem..." Command="{Binding ChooseProblemCommand}" IsEnabled="{Binding CanEdit}" />
                            </StackPanel>
                            <TextBlock Text="{Binding ProblemDescription}" TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
                        </StackPanel>
                        <TabControl Padding="0,6,0,0">
                            <TabItem Header="Parameters">
                                <ScrollViewer>
                                    <ContentControl Content="{Binding ProblemParameters}" />
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Visualization">
                                <ContentControl Content="{Binding ProblemVisuals}" />
                            </TabItem>
                        </TabControl>
                    </DockPanel>
                </Panel>
            </TabItem>

            <TabItem Header="Algorithm">
                <DockPanel>
                    <!-- the algorithm cannot run with this problem (ParameterChecks.AlgorithmWarning) -->
                    <Border DockPanel.Dock="Top" Classes="caution" Margin="0,0,0,8"
                            IsVisible="{Binding AlgorithmWarning, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{Binding AlgorithmWarning}" TextWrapping="Wrap" />
                    </Border>
                    <ScrollViewer>
                        <ContentControl Content="{Binding AlgorithmParameters}" />
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem Header="Results">
                <Grid ColumnDefinitions="340,4,*">
                    <TextBlock Text="No results yet: start the algorithm or its experiment." Opacity="0.6" IsVisible="{Binding Results.IsEmpty}" />
                    <ListBox ItemsSource="{Binding Results.Entries}" SelectedItem="{Binding Results.Selected}" IsVisible="{Binding !Results.IsEmpty}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" Margin="0,0,6,0" Grid.IsSharedSizeScope="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ResultEntryViewModel">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ResultName" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <c:Pictogram Symbol="{Binding KindPictogram}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                                 ToolTip.Tip="{Binding KindTip}" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Summary}" Opacity="0.75" FontFamily="monospace" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                    <ContentControl Grid.Column="2" Margin="10,0,0,0" Content="{Binding Results.Detail}" />
                </Grid>
            </TabItem>

            <TabItem Header="Runs">
                <ContentControl Content="{Binding Runs}" />
            </TabItem>

            <TabItem Header="Operator Graph">
                <Panel>
                    <TextBlock Text="This algorithm has no operator graph." Opacity="0.6" IsVisible="{Binding !HasGraph}" />
                    <ContentControl Content="{Binding Graph}" IsVisible="{Binding HasGraph}" />
                </Panel>
            </TabItem>

            <TabItem Header="Engine">
                <StackPanel Spacing="10" IsVisible="{Binding HasEngine}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Engine" VerticalAlignment="Center" Width="110" />
                        <ComboBox ItemsSource="{Binding Engines}" SelectedItem="{Binding SelectedEngine}" Width="260"
                                  DisplayMemberBinding="{Binding Name, x:DataType=runtime:CatalogEntry}" IsEnabled="{Binding CanEdit}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Execution time" VerticalAlignment="Center" Width="110" />
                        <TextBlock Text="{Binding ExecutionTime}" VerticalAlignment="Center" FontFamily="monospace" />
                    </StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Clear log" Command="{Binding ClearLogCommand}" VerticalAlignment="Top" Margin="8,0,0,0" />
                        <TextBlock Text="Log" FontWeight="SemiBold" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Log}" Height="300" FontFamily="monospace" FontSize="12" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Detailed analysis">
                <ContentControl Content="{Binding Analysis}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
