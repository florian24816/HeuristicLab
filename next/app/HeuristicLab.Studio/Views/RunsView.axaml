<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HeuristicLab.Studio.ViewModels"
             x:Class="HeuristicLab.Studio.Views.RunsView"
             x:DataType="vm:RunsViewModel">
    <!-- the table right at the top, the selected run's details below it in the space that is left -->
    <Grid RowDefinitions="Auto,Auto,*">
        <TextBlock Text="No runs yet." Opacity="0.6" IsVisible="{Binding IsEmpty}" />
        <ContentControl Grid.Row="1" Content="{Binding Grid}" MaxHeight="300" HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="{Binding !IsEmpty}" />
        <ScrollViewer Grid.Row="2" Margin="0,10,0,0" IsVisible="{Binding ShowsDetails}">
            <ItemsControl ItemsSource="{Binding SelectedDetails}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NameValue">
                        <Grid ColumnDefinitions="300,*" Margin="0,1">
                            <TextBlock Text="{Binding Name}" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
