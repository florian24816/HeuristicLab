<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HeuristicLab.Studio.ViewModels"
        x:Class="HeuristicLab.Studio.Views.NewSetupWindow"
        x:DataType="vm:NewSetupViewModel"
        Title="{Binding WindowTitle}" Width="960" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="10">
        <Grid ColumnDefinitions="160,*">
            <TextBlock Text="Algorithm" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Algorithms}" IsEnabled="{Binding ChoosesAlgorithm}"
                      SelectedItem="{Binding SelectedAlgorithm}" DisplayMemberBinding="{Binding Display, x:DataType=vm:Choice}" />
        </Grid>

        <!-- problem and benchmark instance side by side, each searchable -->
        <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,Auto,*" Height="440">
            <TextBlock Text="Problem" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBox Grid.Row="1" Text="{Binding ProblemFilter}" PlaceholderText="Search problems by name, description or category" Margin="0,0,0,6" />
            <ListBox Grid.Row="2" Classes="catalog" ItemsSource="{Binding VisibleProblems}" SelectedItem="{Binding SelectedProblemItem}"
                     ItemTemplate="{StaticResource CatalogItemTemplate}" />
            <TextBlock Grid.Column="2" Text="Benchmark instance" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding InstanceFilter}" PlaceholderText="Search instances" Margin="0,0,0,6"
                     IsEnabled="{Binding HasInstances}" />
            <Panel Grid.Row="2" Grid.Column="2">
                <TextBlock Text="This problem has no benchmark instances." Opacity="0.6" TextWrapping="Wrap" IsVisible="{Binding !HasInstances}" />
                <ListBox ItemsSource="{Binding VisibleInstances}" SelectedItem="{Binding SelectedInstance}" IsVisible="{Binding HasInstances}" />
            </Panel>
        </Grid>

        <Border BorderThickness="1" CornerRadius="4" Padding="10" IsVisible="{Binding AcceptsData}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <Grid ColumnDefinitions="150,*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                <TextBlock Text="Data file" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding DataFile}" PlaceholderText="CSV or Parquet (instead of an instance)" />
                <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseDataCommand}" />
                <TextBlock Grid.Row="1" Text="Target column" VerticalAlignment="Center" />
                <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Columns}" SelectedItem="{Binding Target}" />
                <TextBlock Grid.Row="2" Text="Training %, warm-up" VerticalAlignment="Center" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBox Text="{Binding TrainingPercentText}" Width="70" />
                    <TextBox Text="{Binding TrainingStartText}" Width="70" />
                    <TextBlock Text="first rows train, in file order" VerticalAlignment="Center" Opacity="0.7" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Click="Cancel" />
            <Button Content="{Binding CreateText}" Classes="accent" Click="Create" />
        </StackPanel>
    </StackPanel>
</Window>
