<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HeuristicLab.Studio.ViewModels"
        xmlns:controls="using:HeuristicLab.Studio.Controls"
        xmlns:views="using:HeuristicLab.Studio.Views"
        xmlns:runtime="using:HeuristicLab.Next.Runtime"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="HeuristicLab.Studio.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/HeuristicLab.ico"
        Width="1440" Height="880" MinWidth="900" MinHeight="560"
        Title="HeuristicLab Studio">

    <Window.Styles>
        <!-- the tabs start right of the light/dark and notification buttons -->
        <Style Selector="TabControl.main /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="Margin" Value="90,0,0,0" />
        </Style>
        <!-- light/dark: a square showing the mode it switches to - dark (black on grey) or light (on the logo orange) -->
        <Style Selector="Button.theme">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#BDBDBD" />
        </Style>
        <!-- notifications: off light grey (dark mode: darker grey), on the logo orange -->
        <Style Selector="Button.notify">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource SwitchOffBrush}" />
        </Style>
        <Style Selector="Button.notify:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SwitchOffHoverBrush}" />
        </Style>
        <Style Selector="Button.notify.on">
            <Setter Property="Background" Value="#F7931D" />
        </Style>
        <Style Selector="Button.notify.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E5851A" />
        </Style>
        <Style Selector="Button.theme.dark">
            <Setter Property="Background" Value="#F7931D" />
        </Style>
        <Style Selector="Button.theme:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#A8A8A8" />
        </Style>
        <Style Selector="Button.theme.dark:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E5851A" />
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel>
        <!-- status bar -->
        <Border DockPanel.Dock="Bottom" Padding="10,4" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <TextBlock Text="{Binding Workspace.Status}" />
        </Border>

        <Panel>
        <TabControl Classes="main" Padding="0" SelectedIndex="{Binding SelectedTab}">
            <TabItem Header="Experiments">
                <views:ExperimentWorkspaceView DataContext="{Binding Workspace}" />
            </TabItem>
            <TabItem Header="Runs">
                <ContentControl Content="{Binding Runs}" />
            </TabItem>
            <TabItem Header="Results">
                <ContentControl Content="{Binding RunAnalysis}" />
            </TabItem>
            <TabItem Header="Scripts">
                <ContentControl Content="{Binding Scripts}" />
            </TabItem>
            <TabItem Header="Resources">
                <ContentControl Content="{Binding Resources}" />
            </TabItem>
        </TabControl>
        <Button Classes="theme" Classes.dark="{Binding IsDarkMode}" Command="{Binding ToggleThemeCommand}"
                Margin="14,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Panel>
                <controls:Pictogram Symbol="darkmode" Foreground="Black" IsVisible="{Binding !IsDarkMode}" ToolTip.Tip="Dark mode" />
                <controls:Pictogram Symbol="lightmode" Foreground="Black" IsVisible="{Binding IsDarkMode}" ToolTip.Tip="Light mode" />
            </Panel>
        </Button>
        <Button Classes="notify" Classes.on="{Binding IsNotifying}" Command="{Binding ToggleNotificationsCommand}"
                Margin="52,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                ToolTip.Tip="Notifications: a message in the system's notification center when started experiments, an algorithm or a detailed analysis run finish">
            <controls:Pictogram Symbol="notification" Foreground="Black" />
        </Button>
        <!-- HeuristicLab's logo at the top right, in the tab row -->
        <Image Source="/Assets/HeuristicLab.ico" Width="32" Height="32" Margin="0,10,14,0"
               HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False"
               RenderOptions.BitmapInterpolationMode="HighQuality" ToolTip.Tip="HeuristicLab" />
        </Panel>
    </DockPanel>
</Window>
