<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HeuristicLab.Studio.ViewModels"
             xmlns:c="using:HeuristicLab.Studio.Controls"
             x:Class="HeuristicLab.Studio.Views.ParameterListView"
             x:DataType="vm:ParameterListViewModel">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="No parameters" Opacity="0.6" IsVisible="{Binding IsEmpty}" />
        <ListBox DockPanel.Dock="{Binding ListDock}" Width="{Binding ListWidth}" MaxHeight="{Binding ListMaxHeight}"
                 ItemsSource="{Binding Parameters}" SelectedItem="{Binding Selected}" Margin="0,0,10,8"
                 IsVisible="{Binding !IsEmpty}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ParameterNodeViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding Description}">
                        <c:Pictogram Symbol="{Binding KindPictogram}" Width="16" Height="16" Margin="0,0,8,0"
                                     VerticalAlignment="Center" ToolTip.Tip="{Binding KindTip}"
                                     Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Summary}" Opacity="0.65" MaxWidth="150" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="8,0,0,0" IsVisible="{Binding !HasWarning}" />
                        <!-- a value that probably does not work (or none fits): yellow -->
                        <Border Grid.Column="2" Classes="caution summary" Margin="8,0,0,0" IsVisible="{Binding HasWarning}"
                                ToolTip.Tip="{Binding Warning}">
                            <TextBlock Text="{Binding Summary}" MaxWidth="150" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedText}" FontWeight="SemiBold" Margin="0,0,0,6"
                   IsVisible="{Binding Nested}" TextWrapping="Wrap" />
        <ContentControl Content="{Binding Selected}" />
    </DockPanel>
</UserControl>
