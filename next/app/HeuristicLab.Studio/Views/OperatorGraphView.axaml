<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HeuristicLab.Studio.ViewModels"
             xmlns:c="using:HeuristicLab.Studio.Controls"
             x:Class="HeuristicLab.Studio.Views.OperatorGraphView"
             x:DataType="vm:OperatorGraphViewModel">
    <UserControl.Styles>
        <Style Selector="ItemsControl.canvas > ContentPresenter" x:DataType="vm:GraphNodeView">
            <Setter Property="Canvas.Left" Value="{Binding X}" />
            <Setter Property="Canvas.Top" Value="{Binding Y}" />
        </Style>
        <Style Selector="ItemsControl.labels > ContentPresenter" x:DataType="vm:GraphEdgeView">
            <Setter Property="Canvas.Left" Value="{Binding LabelX}" />
            <Setter Property="Canvas.Top" Value="{Binding LabelY}" />
        </Style>
        <!-- an operator: orange square with its pictogram, then a rounded block shading from the name
             rectangles' light grey (top right) to the orange (bottom left) -->
        <Style Selector="Border.opsquare">
            <Setter Property="Background" Value="#F7931D" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="9" />
        </Style>
        <Style Selector="Border.node">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Width" Value="213" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="12,3" />
            <Setter Property="TextElement.Foreground" Value="#1E1E1E" />
        </Style>
        <Style Selector="Border.node.selected">
            <Setter Property="BorderBrush" Value="#1E1E1E" />
        </Style>
        <Style Selector="Path.edge">
            <Setter Property="Stroke" Value="#6E6E6E" />
            <Setter Property="StrokeThickness" Value="1.6" />
        </Style>
        <Style Selector="Path.edge.back">
            <Setter Property="Stroke" Value="#9A9A9A" />
            <Setter Property="StrokeDashArray" Value="5,3" />
        </Style>
        <Style Selector="Path.arrow">
            <Setter Property="Fill" Value="#6E6E6E" />
        </Style>
        <Style Selector="Path.arrow.back">
            <Setter Property="Fill" Value="#9A9A9A" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,3*,4,2*">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
            <Button Content="Back" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" />
            <Button Content="Open operator graph" Command="{Binding OpenCommand}"
                    ToolTip.Tip="Show the graph inside the selected operator (e.g. the main loop); double-click works too" />
            <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="8,0,0,0" />
            <Slider Minimum="0.4" Maximum="1.6" Value="{Binding Zoom}" Width="120" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" MinHeight="200">
            <ScrollViewer HorizontalScrollBarVisibility="Auto">
                <LayoutTransformControl>
                    <LayoutTransformControl.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                    </LayoutTransformControl.LayoutTransform>
                    <Panel Width="{Binding Width}" Height="{Binding Height}" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <ItemsControl ItemsSource="{Binding Edges}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GraphEdgeView">
                                    <Panel>
                                        <Path Classes="edge" Classes.back="{Binding IsBack}" Data="{Binding Line}" />
                                        <Path Classes="arrow" Classes.back="{Binding IsBack}" Data="{Binding Arrow}" />
                                    </Panel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl Classes="labels" ItemsSource="{Binding Edges}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GraphEdgeView">
                                    <TextBlock Text="{Binding Label}" FontSize="11" Opacity="0.7" IsVisible="{Binding HasLabel}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl Classes="canvas" ItemsSource="{Binding Nodes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GraphNodeView">
                                    <StackPanel Orientation="Horizontal" Spacing="3" Background="Transparent" Cursor="Hand"
                                                Tapped="NodeTapped" DoubleTapped="NodeDoubleTapped" ToolTip.Tip="{Binding Kind}">
                                        <Border Classes="opsquare">
                                            <c:Pictogram Symbol="{Binding Pictogram}" Foreground="#1E1E1E" />
                                        </Border>
                                        <!-- the gradient per block (a brush in a style would be shared between windows) -->
                                        <Border Classes="node">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="100%,0%" EndPoint="0%,100%">
                                                    <GradientStop Offset="0" Color="#EDEDED" />
                                                    <GradientStop Offset="1" Color="#F7931D" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Kind}" FontSize="10" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Panel>
                </LayoutTransformControl>
            </ScrollViewer>
        </Border>
        <GridSplitter Grid.Row="2" ResizeDirection="Rows" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />
        <ScrollViewer Grid.Row="3" Margin="0,8,0,0">
            <ContentControl Content="{Binding SelectedEditor}" />
        </ScrollViewer>
    </Grid>
</UserControl>
